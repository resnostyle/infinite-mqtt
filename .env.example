# Mosquitto
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=home/infinite
MQTT_CLIENT_ID=infinite-mqtt
MQTT_DISCOVERY_ENABLED=true
MQTT_DISCOVERY_PREFIX=homeassistant

# Infinite Campus Parent Portal
# Base URL: district login host without path (e.g. https://district.infinitecampus.org)
IC_BASE_URL=https://district.infinitecampus.org
# District appName: inspect the login page for hidden input name="appName"
IC_DISTRICT=
IC_USERNAME=
IC_PASSWORD=

# Polling (seconds); minimum 60
IC_POLL_INTERVAL_SECONDS=900
# Assignments due within this many days appear on the upcoming topic
IC_UPCOMING_DAYS=7

LOG_LEVEL=INFO
